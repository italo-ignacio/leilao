generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VIEWER
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum StatusOverride {
  SUSPENDED
  CANCELLED
}

enum AuctionMode {
  UNKNOWN
  ELECTRONIC
  LIVE
}

enum ParticipationType {
  UNKNOWN
  LEGAL_ENTITY
  INDIVIDUAL_AND_LEGAL_ENTITY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(254)
  name         String?    @db.VarChar(160)
  passwordHash String
  role         UserRole   @default(VIEWER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?  @db.Timestamptz(3)
  favorites    Favorite[]

  @@map("users")
}

model LoginRateLimit {
  key       String   @id @db.Char(64)
  hits      Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("login_rate_limits")
}

model Auction {
  id                String            @id @default(cuid())
  officialNumber    String            @unique @db.VarChar(40)
  slug              String            @unique @db.VarChar(240)
  title             String            @db.VarChar(240)
  agency            String            @db.VarChar(160)
  unit              String            @db.VarChar(300)
  mode              AuctionMode       @default(UNKNOWN)
  officialUrl       String            @unique
  noticeDocumentUrl String?
  sourceStatus      String?           @db.VarChar(100)
  publicationStatus PublicationStatus @default(DRAFT)
  statusOverride    StatusOverride?
  proposalStartsAt  DateTime?         @db.Timestamptz(3)
  proposalEndsAt    DateTime?         @db.Timestamptz(3)
  classificationAt  DateTime?         @db.Timestamptz(3)
  biddingStartsAt   DateTime?         @db.Timestamptz(3)
  biddingEndsAt     DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?         @db.Timestamptz(3)
  lots              Lot[]

  @@index([deletedAt, publicationStatus, proposalEndsAt])
  @@index([deletedAt, publicationStatus, proposalStartsAt])
  @@index([deletedAt, mode])
  @@map("auctions")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lots      Lot[]

  @@map("categories")
}

model Lot {
  id                         String            @id @default(cuid())
  auctionId                  String
  auction                    Auction           @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  number                     Int
  slug                       String            @unique @db.VarChar(240)
  title                      String            @db.VarChar(240)
  description                String
  categoryId                 String
  category                   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  minimumBid                 Decimal           @db.Decimal(18, 2)
  appraisalValue             Decimal?          @db.Decimal(18, 2)
  currency                   String            @default("BRL") @db.Char(3)
  state                      String            @db.Char(2)
  city                       String            @db.VarChar(160)
  storageFacility            String            @db.VarChar(240)
  pickupAddress              String?
  officialUrl                String            @unique
  sourceStatus               String?           @db.VarChar(100)
  sourceParticipationIconUrl String?
  participationType          ParticipationType @default(UNKNOWN)
  publicationStatus          PublicationStatus @default(DRAFT)
  statusOverride             StatusOverride?
  personalNotes              String?
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt                  DateTime?         @db.Timestamptz(3)
  items                      LotItem[]
  images                     LotImage[]
  favorites                  Favorite[]

  @@unique([auctionId, number])
  @@index([deletedAt, publicationStatus, categoryId, minimumBid])
  @@index([deletedAt, publicationStatus, state, city])
  @@index([deletedAt, publicationStatus, minimumBid])
  @@index([deletedAt, publicationStatus, createdAt])
  @@map("lots")
}

model LotItem {
  id          String   @id @default(cuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  position    Int
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String   @db.VarChar(20)
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([lotId, position])
  @@map("lot_items")
}

model LotImage {
  id         String   @id @default(cuid())
  lotId      String
  lot        Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  storageKey String   @unique
  alt        String   @db.VarChar(300)
  position   Int
  width      Int?
  height     Int?
  mimeType   String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([lotId, position])
  @@map("lot_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, lotId])
  @@index([lotId])
  @@map("favorites")
}
