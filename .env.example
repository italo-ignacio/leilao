# Desenvolvimento local apenas. Troque as credenciais em producao.
POSTGRES_DB=leiloes
POSTGRES_USER=leiloes
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_PORT=55432
DATABASE_URL=postgresql://leiloes:development-only-change-me@localhost:55432/leiloes?schema=public
# Azure: use postgresql://USUARIO:SENHA_CODIFICADA@SERVIDOR.postgres.database.azure.com:5432/BANCO?schema=public&sslmode=require
# Testes de integracao escrevem apenas em um banco LOCAL com migrations aplicadas.
TEST_DATABASE_URL=postgresql://leiloes:development-only-change-me@127.0.0.1:55432/leiloes?schema=public
# Opt-in de uma única execução E2E no Azure: E2E_ALLOW_REMOTE_DATABASE=leiloes npm run test:e2e
# Nunca configure este valor permanentemente. Exige o banco Azure chamado leiloes.
E2E_ALLOW_REMOTE_DATABASE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origem exata do login: protocolo, host e porta usados no navegador.
AUTH_URL=http://localhost:3000
# Use npm run auth:secret para gerar em .env.local sem imprimir o segredo.
# Em producao, configure um segredo forte diretamente no ambiente do deploy.
AUTH_SECRET=
# Deixe vazio sem proxy confiavel; ativa limite compartilhado por cliente.
# Somente configure se o proxy REESCREVE esse header e impede acesso direto ao app.
# Na Vercel, x-vercel-forwarded-for e usado automaticamente se esta variavel nao existir.
AUTH_TRUSTED_IP_HEADER=
# Seed: credenciais obrigatorias, senha com pelo menos 12 caracteres; sem senha padrao.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Nunca ativar no Azure. Dados ficticios sao permitidos apenas em banco local.
SEED_DEMO_DATA=false
# Storage: local, s3 ou minio. Segredos somente no ambiente do servidor.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
# MinIO: endpoint da API S3 em HTTPS, sem bucket nem caminho do console.
# Para ativar, defina STORAGE_DRIVER=minio.
MINIO_BLOB_BUCKET=
MINIO_BLOB_ACCESS_KEY=
MINIO_BLOB_SECRET_KEY=
MINIO_BLOB_PUBLIC_URL=
# AWS S3 / R2: credenciais pela cadeia padrao AWS.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=